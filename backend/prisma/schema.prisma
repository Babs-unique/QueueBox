generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = ""
  moduleFormat        = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String
  password          String
  refreshToken      String?
  expiresAt         DateTime?
  isRevoked         Boolean            @default(false)
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  billingOperations BillingOperation[]
  customers         Customer[]
}

model Customer {
  id          String       @id @default(uuid())
  name        String
  email       String
  userId      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id])
  invoices    Invoice[]
  invoiceJobs InvoiceJob[]

  @@unique([userId, email])
}

model BillingOperation {
  id             String                 @id @default(uuid())
  userId         String
  idempotencyKey String
  billingPeriod  String
  status         BillingOperationStatus
  totalJobs      Int
  processingJobs Int                    @default(0)
  completedJobs  Int                    @default(0)
  failedJobs     Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id])
  invoiceJobs    InvoiceJob[]

  @@unique([userId, idempotencyKey])
}

model InvoiceJob {
  id                 String           @id @default(uuid())
  billingOperationId String
  customerId         String
  invoiceId          String?
  status             InvoiceJobStatus @default(QUEUED)
  lastError          String?
  processedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  billingOperation   BillingOperation @relation(fields: [billingOperationId], references: [id])
  customer           Customer         @relation(fields: [customerId], references: [id])
  invoice            Invoice?         @relation(fields: [invoiceId], references: [id])
}

model Invoice {
  id            String        @id @default(uuid())
  customerId    String
  amount        Decimal       @db.Decimal(10, 2)
  billingPeriod String
  dueDate       DateTime
  status        InvoiceStatus @default(GENERATED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      Customer      @relation(fields: [customerId], references: [id])
  invoiceJobs   InvoiceJob[]

  @@unique([customerId, billingPeriod])
}

enum InvoiceJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum BillingOperationStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  PARTIALLY_COMPLETED
}

enum InvoiceStatus {
  GENERATED
}
